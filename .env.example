# Optional server-only settings. Defaults work locally.
DATABASE_PATH=./data/planner.db
# Set to the exact browser origin when using a private reverse proxy.
# APP_ORIGIN=https://your-device.your-tailnet.ts.net
# Timezone is stored in SQLite settings; initial default is America/Toronto.

# Docker Compose (set APP_ORIGIN above to your exact private HTTPS origin)
# PLANNER_PORT=3100
# PLANNER_IMAGE_TAG=initial
# PLANNER_DATA_DIR=/home/virain/planner/data
# PLANNER_BACKUP_DIR=/home/virain/planner/backups
